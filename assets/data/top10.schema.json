{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Redgrass Tackle Top 10 featured products",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "campaign",
    "title",
    "optionIds",
    "fallbackImage"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string"
    },
    "campaign": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "optionIds": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "fallbackImage": {
      "type": "string",
      "pattern": "^assets/images/[A-Za-z0-9_.-]+$"
    }
  }
}
